#!/usr/bin/env python3
"""Executable entry point for uniservice.

The command is shipped as a plain script (in addition to the ``console_scripts``
entry point) so that the install scripts only have to copy the repository next
to it - no virtual environment or ``pip install`` step is required.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _ensure_package_on_path() -> None:
    """Make ``uniservice_lib`` importable when run from a copied directory."""
    here = Path(__file__).resolve().parent
    if str(here) not in sys.path:
        sys.path.insert(0, str(here))


def main() -> int:
    _ensure_package_on_path()
    from uniservice_lib.cli import main as cli_main

    return cli_main(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
